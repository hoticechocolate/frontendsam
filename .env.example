# Supabase 대시보드 → Project Settings → API Keys
# 이 파일을 복사해서 이름을 .env 로 바꾸고 값을 채우세요 (.env 는 깃에 안 올라감)
VITE_SUPABASE_URL=https://kinjeyanbgxxeinswbpm.supabase.co

# publishable 키(sb_publishable_…) 또는 Legacy 탭의 anon 키(eyJ…)
# ⚠ secret / service_role 키는 절대 넣지 말 것 — VITE_ 값은 브라우저에 그대로 노출됨
VITE_SUPABASE_ANON_KEY=

VITE_SUPABASE_BUCKET=sic-images
